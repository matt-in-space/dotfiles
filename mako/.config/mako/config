# Tokyo Night — matched to Waybar/wofi (Hack Nerd Font, 10px radius, blue accent)

font=Hack Nerd Font 11
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #283457

border-size=2
border-radius=10
padding=14
margin=10
width=360
height=120
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0

layer=overlay
anchor=top-right
max-visible=5

[urgency=low]
border-color=#565f89
text-color=#a9b1d6
default-timeout=3000

[urgency=normal]
border-color=#7aa2f7

[urgency=critical]
border-color=#f7768e
text-color=#f7768e
default-timeout=0

[mode=do-not-disturb]
invisible=1
