{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-left": 16,
  "margin-right": 16,
  "margin-top": 7,
  "margin-bottom": 0,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/padd",
    "hyprland/workspaces",
    "custom/spacer",
    "mpris"
  ],
  "modules-center": [
    "custom/l_end",
    "hyprland/window",
    "custom/r_end"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "memory",
    "cpu",
    "battery",
    "idle_inhibitor",
    "clock",
    "tray",
    "custom/power",
    "custom/padd",
    "custom/hyprwhspr"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "default": "",
      "active": ""
    }
  },
  "hyprland/window": {
    "format": "<span weight='bold'>{class}</span>",
    "max-length": 120,
    "icon": false,
    "separate-outputs": true
  },
  "mpris": {
    "interval": 1,
    "format": "{player_icon} {dynamic}",
    "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
    "max-length": 50,
    "player-icons": {
      "default": "\u23f8",
      "mpv": "\ud83c\udfb5"
    },
    "status-icons": {
      "paused": "\u25b6"
    }
  },
  "memory": {
    "interval": 1,
    "rotate": 270,
    "format": "{icon}",
    "format-icons": [
      "\udb81\udf66",
      "\udb82\ude9e",
      "\udb82\ude9f",
      "\udb82\udea0",
      "\udb82\udea1",
      "\udb82\udea2",
      "\udb82\udea3",
      "\udb82\udea4",
      "\udb82\udea5"
    ],
    "tooltip-format": "RAM {percentage}% \u2014 {used:0.1f}G / {total:0.1f}G",
    "max-length": 10
  },
  "cpu": {
    "interval": 1,
    "rotate": 270,
    "format": "{icon}",
    "format-icons": [
      "\udb81\udf66",
      "\udb82\ude9e",
      "\udb82\ude9f",
      "\udb82\udea0",
      "\udb82\udea1",
      "\udb82\udea2",
      "\udb82\udea3",
      "\udb82\udea4",
      "\udb82\udea5"
    ],
    "tooltip": false
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon}",
    "format-charging": "<span color='#a6d189'>\udb85\udc0b</span>",
    "format-plugged": "\udb80\udc84",
    "format-icons": [
      "\udb81\udf66",
      "\udb82\ude9e",
      "\udb82\ude9f",
      "\udb82\udea0",
      "\udb82\udea1",
      "\udb82\udea2",
      "\udb82\udea3",
      "\udb82\udea4",
      "\udb82\udea5"
    ],
    "tooltip-format": "{capacity}% \u2014 {timeTo}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\udb82\udd54",
      "deactivated": ""
    }
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "tooltip": true,
    "interval": 2,
    "rotate": 0,
    "format-wifi": "{icon} ",
    "format-icons": [
      "\udb82\udd1f",
      "\udb82\udd22",
      "\udb82\udd25"
    ],
    "format-ethernet": "\udb80\ude00 ",
    "format-linked": "\udb80\ude00 {ifname} (No IP)",
    "format-disconnected": " ",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal: <b>{signaldBm}dBm ({signalStrength}%)</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>",
    "tooltip-format-disconnected": "Disconnected"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\udb81\udf5f",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "tray": {
    "icon-size": 16,
    "rotate": 0,
    "spacing": 3
  },
  "custom/spacer": {
    "format": "|"
  },
  "custom/l_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/r_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },
  "custom/padd": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout"
  },
  "include": [
    "/home/ashcan/.config/waybar/hyprwhspr-module.jsonc"
  ]
}